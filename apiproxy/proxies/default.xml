<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-base64</Name>
      </Step>
      <Step>
        <Name>JS-decode-jws-payload</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows/>
  <HTTPProxyConnection>
    <BasePath>/base64decodeurl</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="default"/>
</ProxyEndpoint>
